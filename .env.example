# Public address of the FastAPI service when the frontend and API are deployed separately.
# For local Wi-Fi testing this can be omitted: the app uses the current device's host on port 8000.
VITE_API_URL=https://continued-francisco-shops-img.trycloudflare.com   

# Backend AI coach configuration. The model is intentionally deployment-configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
