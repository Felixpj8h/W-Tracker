# Same-origin API path in production. Use a complete HTTPS /api/v1 URL only
# when the frontend and API are intentionally deployed on different origins.
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=

# Google OAuth settings used by the FastAPI token verifier. Use the same client
# ID as the frontend and comma-separate any Google accounts that may sign in.
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=

# Production service settings.
APP_ENV=production
DATABASE_URL=sqlite:////data/workout_tracker.db
PUBLIC_ORIGIN=https://tracker.example.com
ALLOWED_ORIGINS=https://tracker.example.com
ENABLE_API_DOCS=false

# Backend AI coach configuration. The model is intentionally deployment-configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
